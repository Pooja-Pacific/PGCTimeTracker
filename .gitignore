# Build / output folders
bin/
obj/
out/
publish/

# Visual Studio caches, user prefs, and generated files
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider
.idea/
*.sublime-workspace
*.sublime-project

# VS Code (optional - remove if you want to check in workspace settings)
.vscode/

# NuGet
packages/
*.nupkg
project.lock.json
project.fragment.lock.json
artifacts/

# Dotnet publish / tooling
*.dll
*.exe
*.app
*.class
*.so
*.dylib

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# User secrets (dotnet user-secrets stores secrets outside repo, but this helps)
secrets.json
appsettings.*.Secrets.json

# Environment files
.env
.env.*.local
.env.local

# Certificate / key files
*.pfx
*.key
*.cer
*.pem

# Database files
*.mdf
*.ldf
*.sqlite
*.db
*.db3

# Test result files
TestResults/
*.trx
*.coverage
coverage*.json
coverage*.xml

# Profiling
*.psess
*.vsp
*.vspx

# Temporary files
*.tmp
*.cache
*.bak
*.backup
*.swp

# JetBrains Rider caches & workspace
.idea/
*.DotSettings.user

# Generated files
Generated\/

# Composer / npm / node modules (if your project contains front-end)
node_modules/
bower_components/

# Package signing
*.snk

# MonoDevelop
*.userprefs

# Ignore publish folders created by 'dotnet publish'
**/publish/

# Ignore Azure DevOps / pipeline artifacts
.terraform/
#.azure-pipelines/

# Optional: ignore lock files if you prefer not to commit them (usually you should commit)
# package-lock.json
# yarn.lock
