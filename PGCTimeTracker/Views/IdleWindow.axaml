<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PGCTimeTracker.IdleWindow"
		xmlns:vm="clr-namespace:PGCTimeTracker.ViewModels"
        Title="IdleWindow"
        Width="800" Height="450"
        WindowStartupLocation="CenterScreen">

	<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
		<TextBlock Text="Logged in successfully!"
                   FontSize="20" FontWeight="Bold" Margin="0,10"/>

		<!-- Bind welcome message -->
		<TextBlock Text="{Binding WelcomeMessage}"
                   FontSize="16" Margin="0,5"/>

		<TextBlock Text="v2.0"
                   FontSize="12" Foreground="Gray" Margin="0,20"/>
	</StackPanel>
</Window>
