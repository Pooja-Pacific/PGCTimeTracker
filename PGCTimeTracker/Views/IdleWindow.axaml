<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PGCTimeTracker_V2.IdleWindow"
        Title="IdleWindow"
        Width="800"
        Height="450"
        WindowStartupLocation="CenterScreen"
        Background="White"
        CanResize="False">

	<Grid>
		<!-- Background Image -->
		<Image Source="avares://PGCTimeTracker_V2/Assets/LOGIN-FORM.png" Stretch="Fill"/>

		<!-- Foreground Content -->
		<Border Width="320"
				 Height="280"
                Padding="20"
                Background="White"
                CornerRadius="12"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="240,80,80,80">
			<Border.Effect>
				<DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.2"/>
			</Border.Effect>

			<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
				<TextBlock Text="Logged in successfully!"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>

				<TextBlock Text="{Binding WelcomeMessage}"
                           FontSize="16"
                           HorizontalAlignment="Center"/>

				<TextBlock Text="v2.0"
                           FontSize="12"
                           Foreground="Gray"
                           HorizontalAlignment="Center"/>
			</StackPanel>
		</Border>
	</Grid>
</Window>