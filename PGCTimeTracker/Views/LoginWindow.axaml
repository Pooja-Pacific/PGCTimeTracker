<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PGCTimeTracker.Views.LoginWindow"
        Title="LOGIN"
        Width="800"
        Height="450"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="White">	

	<Grid>
		<!-- Background Image -->
		<Image Source="avares://PGCTimeTracker/Assets/LOGIN-FORM.png" Stretch="Fill"/>

		<!-- Login Panel -->
		<Border Width="320"
                Padding="20"
                Background="White"
                CornerRadius="12"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="240,180,80,80">
			<Border.Effect>
				<DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.2"/>
			</Border.Effect>

			<StackPanel Spacing="15">
				<!-- Email -->
				<Grid Margin="2">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<!-- Label column -->
						<ColumnDefinition Width="*"/>
						<!-- TextBox column -->
					</Grid.ColumnDefinitions>

					<TextBlock Text="Email Address :"
							   FontSize="12"
							   FontWeight="Bold"
							   Foreground="#404040"
							   VerticalAlignment="Center"
							   Grid.Column="0"
							   Margin="0,0,10,0"/>

					<TextBox Text="{Binding Username, Mode=TwoWay}"
							 Width="200"
							 Height="22"
							 FontSize="10"
							 Padding="10"
							 BorderBrush="#CCC"
							 Watermark="Please enter email ID"
							 Margin="5,0,0,0"
							 Grid.Column="1"/>
				</Grid>

				<!-- Password -->
				<Grid Margin="2">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<!-- Label column -->
						<ColumnDefinition Width="*"/>
						<!-- TextBox column -->
					</Grid.ColumnDefinitions>

					<TextBlock Text="Password :"
							   FontSize="12"
							   FontWeight="Bold"
							   Foreground="#404040"
							   VerticalAlignment="Center"
							   Grid.Column="0"
							   Margin="0,0,10,0"/>

					<Grid Grid.Column="1" HorizontalAlignment="Left">
						<TextBox Text="{Binding Password, Mode=TwoWay}"
								 PasswordChar="{Binding PasswordChar}"
								 Width="200"
								 Height="22"
								 FontSize="10"
								 BorderBrush="#CCC"								
								 Margin="5,0,0,0"
								 Watermark="Please enter your password" />

						<Button Command="{Binding TogglePasswordVisibilityCommand}"
								Width="20"
								Height="20"
								HorizontalAlignment="Right"
								VerticalAlignment="Center"
								Margin="0,0,5,0"
								Background="Transparent"
								Cursor="Hand">
							<Image Source="avares://PGCTimeTracker/Assets/eye.png"
								   Width="16"
								   Height="16"/>
						</Button>
					</Grid>
				</Grid>

				<!-- Login Button -->
				<Button x:Name="btnLogin"
							Classes="login-button"
							Content="Login"
							Width="176"
							Height="32"
							FontFamily="Segoe UI"
							FontSize="11.25"
							FontWeight="Bold"
							Background="#2596BE"
							Foreground="White"
							BorderThickness="0"
							Command="{Binding LoginCommand}"
							IsEnabled="{Binding CanLogin}"
							Margin="0,10,0,0"
							Padding="0"
							HorizontalAlignment="Center"
							VerticalAlignment="Top"
						  HorizontalContentAlignment="Center"
						  VerticalContentAlignment="Center"/>

				<!-- Version -->
				<TextBlock Text="v2.0"
                           HorizontalAlignment="Center"
                           Foreground="Gray"
                           FontSize="10"
                           Margin="0,7,0,0"/>
			</StackPanel>
		</Border>
	</Grid>
</Window>